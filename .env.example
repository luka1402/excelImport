# Kopirajte u .env i postavite lozinke. .env se nikad ne komituje.
# SA lozinka mora imati min. 8 karaktera i 3 od 4 grupe (velika, mala, cifra, simbol).
MSSQL_SA_PASSWORD=
# Port na hostu (podrazumevano 14333 da se ne sudara sa lokalnim SQL Serverom na 1433)
MSSQL_PORT=14333
# Opcioni login sa minimalnim pravima (db_datareader + db_datawriter na DemoDb).
# Ako je lozinka prazna, login se ne kreira.
DEMO_APP_LOGIN=demo_importer
DEMO_APP_PASSWORD=
